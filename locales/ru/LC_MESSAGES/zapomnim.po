#: handlers/business/test.py:27 handlers/main_menu.py:25
#: handlers/main_menu.py:44 handlers/main_menu.py:97
msgid "START_IMAGE"
msgstr "resources/start_image_ru.png"

#: handlers/main_menu.py:26
msgid "START_TEXT"
msgstr ""
"<b>👋 ZAPOMNIM — это продвинутое расширение для Telegram</b>, которое "
"работает параллельно с вашей учетной записью, <b>без доступа к ней</b>.\n"
"\n"
"🔒 Мы расширяем ваши возможности и надежно защищаем переписки, <b>сохраняя"
" конфиденциальность и полный контроль</b> исключительно за вами.\n"
"\n"
"🔍 <b>Функции ZAPOMNIM</b>:\n"
"- Перехват удалённых сообщений.\n"
"- Отслеживание изменений сообщений.\n"
"- Сохранение исчезающих медиафайлов.\n"
"- Проверка незнакомцев на скам.\n"
"- Интеллектуальная защита от мошенников.\n"
"- Персонализация бота под ваши задачи.\n"
"- …и ещё больше новых функций скоро!\n"
"\n"
"⚡️ <b>Безопасно. Умно. Удобно. Это — ZAPOMNIM.</b>"

#: handlers/main_menu.py:35
msgid "ONLY_FOR_TELEGRAM_PREMIUM"
msgstr "😢 К сожалению, бот доступен только подписчикам Telegram Premium"

#: handlers/main_menu.py:45 handlers/main_menu.py:57
msgid "CONNECT_BOT_INSTRUCTION"
msgstr ""
"<b>🛠️ Готовимся к запуску!</b>\n"
"<i>Для начала создадим вашего Telegram-бота</i>\n"
"\n"
"🔹 <b>Сделайте всего несколько шагов:</b>\n"
"1. Откройте <a "
"href=\"https://t.me/BotFather?text=%2Fnewbot\">@BotFather</a> и введите "
"команду <code>/newbot</code>.\n"
"2. Придумайте любое имя и username для вашего бота.\n"
"3. Скопируйте токен и отправьте его сюда.\n"
"\n"
"<b>🧐 Пример токена:</b>\n"
"<blockquote>5995761349:AAGmBOCDXTBNW4S...</blockquote>\n"
"\n"

#: handlers/main_menu.py:62 handlers/main_menu.py:70
msgid "INVALID_TOKEN"
msgstr "<b>⛔️ Вы прислали неверный токен.</b>"

#: handlers/main_menu.py:65 handlers/main_menu.py:73
msgid "CHECKING_BOT"
msgstr "<i>✅ Подключение к %s ...</i>"

#: handlers/main_menu.py:84 handlers/main_menu.py:120
msgid "BOT_SETUP_COMPLETE"
msgstr ""
"💥 <b>Бот @%s подключен!</b>\n"
"Для завершения настройки, продолжите в созданном вами боте."

#: handlers/main_menu.py:98
msgid "BOT_SETUP_BUSINESS_INSTRUCTION"
msgstr ""
"<b>🚦 Успех! Переходим к следующему шагу.\n"
"</b><i>Теперь активируем «Business Mode» у вашего бота.</i>\n"
"\n"
"✅ <b>Сделайте следующее:</b>\n"
"1. Войдите в <a "
"href=\"https://t.me/BotFather?text=%2Fmybots\">@BotFather</a> и отправьте"
" команду <code>/mybots</code>.\n"
"2. Выберите из списка своего созданного бота.\n"
"3. Нажмите <b>Bot Settings</b>, затем найдите и активируйте режим "
"<b>Business Mode</b>.\n"
"\n"
"✨ <i>Нажмите на кнопку ниже, как только выполните это действие.</i>"

#: handlers/main_menu.py:113
msgid "BUSINESS_MODE_IS_NOT_ENABLED"
msgstr "⛔️ Business Mode не был включен. Попробуйте еще раз."

#: keyboards/main_menu.py:9
msgid "START_BUTTON"
msgstr "🚀 Поехали!"

#: keyboards/main_menu.py:16
msgid "CHECK_BUSINESS_BUTTON"
msgstr "✅ Подтвердить"

#: keyboards/main_menu.py:23
msgid "GO_TO_BOT_BUTTON"
msgstr "🚪 Перейти в бота"

