"\n"
"<b>Old Text (from {date})</b>:\n"
"<blockquote expandable>{old_text}</blockquote>\n"
"\n"
"<b>New Text</b>:\n"
"<blockquote expandable>{new_text}</blockquote>\n"
"\n"
"<i>Chat: {chat}, Message #{id}</i>"

